# === Database ===
DATABASE_URL=sqlite:///./forgettery.db

# === Gemini ===
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# === Game tuning ===
DECAY_TICK_INTERVAL=1.0    # seconds between decay ticks
INITIAL_HALF_LIFE=120.0    # starting half-life for every concept (seconds)
GP_LENGTH_SCALE=1.5        # RBF kernel length scale for the uncertainty GP
THOMPSON_LAMBDA=0.6        # 0=pure exploitation, 1=pure exploration
VOID_THRESHOLD=0.2         # recall probability below which a tile enters void state

# === Server ===
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
